import java.sql.*;

public class CategoryAveragePrice {
    public static void main(String[] args) {

        try {
            Class.forName("com.microsoft.sqlserver.jdbc.SQLServerDriver");

            Connection connection = DriverManager.getConnection(
                    "jdbc:sqlserver://localhost:1433;databaseName=ProductDB;encrypt=true;trustServerCertificate=true",
                    "sa",
                    "StrongPass@123");

            String query =
                    "SELECT C.CatDesc, AVG(P.Price) AS AveragePrice " +
                    "FROM Category C INNER JOIN Product P " +
                    "ON C.CatId=P.CatId " +
                    "GROUP BY C.CatDesc";

            PreparedStatement pstmt = connection.prepareStatement(query);
            ResultSet resultSet = pstmt.executeQuery();

            System.out.println("CATEGORY\tAVERAGE PRICE");

            while (resultSet.next()) {
                System.out.println(
                        resultSet.getString("CatDesc") + "\t" +
                        resultSet.getDouble("AveragePrice"));
            }

            resultSet.close();
            pstmt.close();
            connection.close();

        } catch (Exception ex) {
            ex.printStackTrace();
        }
    }
}
